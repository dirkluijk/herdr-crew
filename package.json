{
  "name": "herdr-crew",
  "version": "0.1.0",
  "description": "Crew dashboard and conventions for projects with Herdr agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dirkluijk/herdr-crew.git"
  },
  "homepage": "https://github.com/dirkluijk/herdr-crew#readme",
  "bugs": {
    "url": "https://github.com/dirkluijk/herdr-crew/issues"
  },
  "type": "module",
  "bin": {
    "herdr-crew": "server.mjs"
  },
  "files": [
    "server.mjs",
    "lib",
    "locales",
    "public",
    "widgets",
    "skills",
    "commands",
    "README.md",
    "DESIGN.md",
    "LICENSE",
    "docs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test 'test/*.test.mjs'",
    "check": "node --check server.mjs && for f in lib/*.mjs widgets/*.mjs; do node --check $f; done"
  },
  "license": "MIT"
}
