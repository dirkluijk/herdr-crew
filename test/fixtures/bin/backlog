#!/usr/bin/env node
// Stub for the backlog CLI in tests. task view: NEW-1 has JSON output, OLD-1 only plain text (like an older
// Backlog.md without --json), ODD-1 JSON with an unknown schema; anything else is not found.
const [cmd, sub, id, flag] = process.argv.slice(2);

if (cmd === "task" && sub === "view") {
  if (flag === "--json" && id === "NEW-1") {
    console.log(JSON.stringify({
      schemaVersion: 1, kind: "task-view",
      task: {
        id: "NEW-1", title: "New <b>task</b>", status: "In Progress", labels: ["ui"], assignees: ["@m2-tests"], dependencies: ["OLD-1"],
        dependencyGraph: { nodes: [{ id: "OLD-1", title: "Old task", status: "Done" }] },
        description: "Some **bold** text <script>alert(1)</script>",
        acceptanceCriteria: [{ index: 1, text: "First", checked: true }, { index: 2, text: "Second", checked: false }],
      },
    }));
  } else if (flag === "--json" && id === "ODD-1") {
    console.log(JSON.stringify({ schemaVersion: 99, kind: "task-view", task: { id: "ODD-1" } }));
  } else if (flag === "--json" && id === "OLD-1") {
    console.error("error: unknown option '--json'");
    process.exit(1);
  } else if (flag === "--plain" && ["NEW-1", "OLD-1", "ODD-1"].includes(id)) {
    console.log(`Task ${id} - plain\n\u001b[1mStatus:\u001b[0m Done`);
  } else {
    console.error(`Task ${id} not found.`);
    process.exit(1);
  }
} else if (cmd === "task" && sub === "list" && process.env.HERDR_CREW_TEST_TASKS) {
  const { readFileSync, existsSync } = await import("node:fs");
  const file = process.env.HERDR_CREW_TEST_TASKS;
  console.log(existsSync(file) ? readFileSync(file, "utf8") : JSON.stringify({ tasks: [] }));
} else {
  console.log(JSON.stringify({ tasks: [] }));
}
